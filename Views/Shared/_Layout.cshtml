@{ var role = Context.Session.GetString("Role"); }
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · RaceDay</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="top">
    <div class="container top-inner">
        <a class="brand" asp-controller="Events" asp-action="Index">RACE<span>DAY</span></a>
        <nav aria-label="Main menu">
            <a asp-controller="Events" asp-action="Index">Find events</a>
            @if (role == "Organiser")
            {
                <a asp-controller="Organiser" asp-action="Index">Dashboard</a>
                <a asp-controller="Organiser" asp-action="Categories">Categories</a>
                <a asp-controller="Organiser" asp-action="Routes">Routes</a>
            }
            @if (role == "Participant")
            {
                <a asp-controller="Participant" asp-action="Entries">My events</a>
                <a asp-controller="Participant" asp-action="Results">My results</a>
                <a asp-controller="Participant" asp-action="Profile">Profile</a>
            }
            @if (role == null)
            {
                <a asp-controller="Account" asp-action="Login">Log in</a>
                <a class="nav-accent" asp-controller="Account" asp-action="Register">Join RaceDay</a>
            }
            else
            {
                <form asp-controller="Account" asp-action="Logout" method="post"><button class="nav-button">Log out</button></form>
            }
        </nav>
    </div>
</header>
<main class="container main-area">
    @if (TempData["Message"] is string message) { <p class="notice" role="status">@message</p> }
    @RenderBody()
</main>
<footer class="container footer">RaceDay · Run / Walk / Cycle</footer>
</body>
</html>
