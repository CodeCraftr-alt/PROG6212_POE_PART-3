@model List<Entry>
@{ ViewData["Title"] = "My events"; }
<p class="eyebrow">Participant</p><h1>My events</h1>
@if (Model.Count == 0) { <p class="panel">You haven't entered an event yet. <a asp-controller="Events" asp-action="Index">Find an event</a>.</p> }
<div class="cards">
@foreach (var entry in Model)
{
    <article class="panel">
        <span class="status @entry.Status.ToLowerInvariant()">@entry.Status</span>
        <h2>@entry.EventName</h2><p>@entry.EventDate?.ToString("dd MMM yyyy") · @entry.CategoryName</p>
        <a asp-controller="Events" asp-action="Details" asp-route-id="@entry.EventID">View event</a>
        @if (entry.Status == "Active")
        {
            <form asp-action="Cancel" asp-route-id="@entry.EnrollmentID" method="post"><button class="button secondary">Cancel entry</button></form>
        }
    </article>
}
</div>
