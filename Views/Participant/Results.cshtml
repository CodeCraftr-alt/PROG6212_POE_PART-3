@model List<Result>
@{ ViewData["Title"] = "My results"; }
<p class="eyebrow">Participant</p><h1>My results</h1>
@if (Model.Count == 0) { <p class="panel">Your results will appear here after an organiser publishes them.</p> }
<div class="cards">
@foreach (var result in Model.OrderByDescending(r => r.EventDate))
{
    <article class="panel">
        <p class="eyebrow">@result.EventDate?.ToString("dd MMM yyyy") · @result.CategoryName</p>
        <h2>@result.EventName</h2>
        <p>Finish time: <strong>@result.FinishTime.ToString("HH:mm:ss")</strong></p>
        <p>Position: <strong>@result.Position</strong> out of @result.Finishers recorded finishers</p>
    </article>
}
</div>
